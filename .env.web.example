# LLM Wiki Web Edition deployment settings.
# Copy to .env.web.local for a manual launch, or to /etc/llm-wiki/web.env for systemd.
# Keep the real file owned by the service account and mode 0600.

# Installed headless server binary (not the desktop `llm-wiki` binary).
LLM_WIKI_WEB_SERVER_BIN=/opt/llm-wiki/bin/llm-wiki-server

# The server supports plaintext upstream only. It must remain on loopback and
# be published through the HTTPS Caddy configuration in deploy/caddy/.
LLM_WIKI_WEB_HOST=127.0.0.1
LLM_WIKI_WEB_PORT=19828
LLM_WIKI_WEB_WORKSPACE_ROOT=/srv/llm-wiki/projects
LLM_WIKI_WEB_DATA_DIR=/var/lib/llm-wiki
LLM_WIKI_WEB_ROOT=/opt/llm-wiki/dist

# Advertised LAN HTTPS address. The Rust service still binds only to loopback;
# Caddy publishes this address. Leave IPv4 empty to auto-detect the route source.
LLM_WIKI_WEB_PUBLIC_IPV4=10.37.12.240
LLM_WIKI_WEB_PUBLIC_HTTPS_PORT=8443

# Set a unique random value in the real 0600 config, for example:
# openssl rand -hex 32
# LLM_WIKI_WEB_BOOTSTRAP_TOKEN=

# Optional OpenAI-compatible chat provider. These values stay on the server and
# are never returned to the browser. HTTPS endpoints are recommended; loopback
# HTTP is allowed for a local model gateway such as Ollama-compatible proxies.
# LLM_WIKI_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# LLM_WIKI_LLM_MODEL=gpt-4.1-mini
# LLM_WIKI_LLM_API_KEY=
